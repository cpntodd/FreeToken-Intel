#version 460

#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const int TILE_M = 8;
layout(constant_id = 1) const int TILE_N = 16;
layout(constant_id = 2) const int TILE_K = 16;

layout(binding = 0) readonly buffer InputBuffer { float16_t values[]; } input_data;
layout(binding = 1) readonly buffer WeightBuffer { float16_t values[]; } weight_data;
layout(binding = 2) writeonly buffer OutputBuffer { float values[]; } output_data;

layout(push_constant) uniform Dimensions {
    uint rows;
    uint input_size;
    uint output_size;
    uint padded_input_size;
    uint padded_output_size;
} dims;

void main() {
    uint tile_row = gl_WorkGroupID.y;
    uint tile_column = gl_WorkGroupID.x;
    uint input_row_offset = tile_row * uint(TILE_M) * dims.padded_input_size;
    uint weight_column_offset = tile_column * uint(TILE_N);

    coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_K, gl_MatrixUseA> a;
    coopmat<float16_t, gl_ScopeSubgroup, TILE_K, TILE_N, gl_MatrixUseB> b;
    coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator> c =
        coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>(0.0);

    for (uint k = 0; k < dims.padded_input_size; k += uint(TILE_K)) {
        coopMatLoad(a, input_data.values, input_row_offset + k,
                    dims.padded_input_size, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(b, weight_data.values,
                    k * dims.padded_output_size + weight_column_offset,
                    dims.padded_output_size, gl_CooperativeMatrixLayoutRowMajor);
        c = coopMatMulAdd(a, b, c);
    }

    uint output_offset = tile_row * uint(TILE_M) * dims.padded_output_size
        + weight_column_offset;
    coopMatStore(c, output_data.values, output_offset, dims.padded_output_size,
                 gl_CooperativeMatrixLayoutRowMajor);
}
